# ============================================================================
# octogent-brain / argued.dev — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Cloudflare Turnstile (rate-limit / spam protection) ---------------------
# Used by /argue POST. If unset, verification is SKIPPED (graceful degrade)
# and the server logs a one-shot warning. Required for HN-launch / production.
#
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# Cloudflare's documented test keys (always-pass / always-fail) — handy for dev:
#   Site (always passes):    1x00000000000000000000AA
#   Secret (always passes):  1x0000000000000000000000000000000AA
#   Site (always fails):     2x00000000000000000000AB
#   Secret (always fails):   2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- argue-api server --------------------------------------------------------
PORT=3001
# SQLite path. Defaults to ./db/argued.sqlite — set to :memory: for tests.
ARGUED_DB_PATH=

# --- npm publish (CI only — set as GitHub Actions secret, not here) ---------
# NPM_TOKEN must be configured under repo Settings -> Secrets -> Actions.
# The npm-publish workflow hard-fails if it's missing.
