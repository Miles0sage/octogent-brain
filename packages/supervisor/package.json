{
  "name": "@octogent/supervisor",
  "version": "0.3.0",
  "description": "Mechanical-supervision substrate for autonomous coding agents. Cross-CLI dispatcher + verdict-gate that catches rubber-stamp passes and forces re-iteration. Aider writes, Claude evaluates, your gate keeps both honest.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miles0sage/octogent-brain.git",
    "directory": "packages/supervisor"
  },
  "keywords": [
    "ai",
    "agent",
    "supervisor",
    "claude",
    "aider",
    "mechanical-supervision",
    "verdict-gate",
    "rubber-stamp",
    "cross-cli",
    "agent-orchestration",
    "anthropic",
    "octogent"
  ],
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "prebuild:dist": "pnpm --dir ../core build:dist",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build:dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@octogent/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
