{
  "name": "@octogent/core",
  "version": "0.3.0",
  "description": "Framework-agnostic domain types + verdict-gate + review-fix-loop for the @octogent/supervisor substrate. Pure-TS, no I/O.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miles0sage/octogent-brain.git",
    "directory": "packages/core"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build:dist",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  }
}
