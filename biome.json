{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "coverage",
      ".omc",
      ".planning",
      "vendor",
      "apps/argue-api/db",
      "packages/pr-fetcher/tests/*.test.js",
      "packages/pr-fetcher/tests/*.test.d.ts"
    ]
  }
}
